{
  // Declarative agent registry — adding a new external agent CLI is an entry
  // here, never a code change.
  //   Spawn-time placeholders: {task}, {workdir}.
  //   Load-time path placeholders, so this file stays portable between machines:
  //   {npmRoot} (global npm module dir), {home}, {appData}, {localAppData}.
  //   Never hardcode an absolute user path here: it makes every profile dead on
  //   arrival on anyone else's machine, which reads as "Jaravi is broken".
  "agents": [
    {
      "id": "echo-demo",
      "description": "Dependency-free demo agent: echoes the task, streams a few lines and exits 0.",
      "command": "cmd.exe",
      "args": ["/c", "echo [echo-demo] task: {task} & echo working in {workdir} & ping -n 3 127.0.0.1 > NUL & echo done"],
      "io": "pipe",
      "idleTimeoutSeconds": 30
    },
    {
      "id": "flood-demo",
      "description": "Stress demo: emits 50000 lines to prove the boss agent's context can never be flooded.",
      "command": "cmd.exe",
      "args": ["/c", "for /L %i in (1,1,50000) do @echo flood line %i"],
      "io": "pipe"
    },
    {
      "id": "claude",
      "description": "Claude Code as a headless sub-agent (non-interactive print mode).",
      "command": "claude",
      "args": ["-p", "{task}"],
      "unattendedArgs": ["--dangerously-skip-permissions"],
      "env": { "CI": "true" },
      "envAllowlist": ["ANTHROPIC_MODEL"],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    },
    {
      "id": "copilot",
      "description": "GitHub Copilot CLI, non-interactive prompt mode. Invoked via node directly (the .cmd shim mangles multi-line briefs). --allow-all-tools is required for non-interactive runs.",
      "command": "node",
      "args": ["{npmRoot}\\@github\\copilot\\npm-loader.js", "-p", "{task}"],
      "unattendedArgs": ["--allow-all-tools"],
      "env": { "CI": "true" },
      "envAllowlist": [],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    },
    {
      "id": "antigravity",
      "description": "Antigravity CLI (agy) as a sub-agent in non-interactive print mode.",
      "command": "{localAppData}\\agy\\bin\\agy.exe",
      "args": ["--print", "{task}", "--print-timeout", "15m"],
      "unattendedArgs": ["--dangerously-skip-permissions"],
      "env": { "CI": "true" },
      "envAllowlist": [],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 600
    },
    {
      "id": "codex",
      "description": "OpenAI Codex CLI as a sub-agent, non-interactive exec mode (#1 on Terminal-Bench 2.1 as of jul-2026). Invoked via node directly — the .cmd shim wraps cmd.exe and mangles multi-line briefs.",
      "command": "node",
      "args": ["{npmRoot}\\@openai\\codex\\bin\\codex.js", "exec", "{task}", "--skip-git-repo-check"],
      "unattendedArgs": ["--full-auto"],
      "env": {},
      "envAllowlist": [],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    },
    {
      "id": "opencode",
      "description": "OpenCode CLI as a sub-agent (direct binary — npm .cmd shims mangle multi-line args).",
      "command": "{npmRoot}\\opencode-ai\\bin\\opencode.exe",
      "args": ["run", "{task}"],
      "unattendedArgs": [],
      "env": { "CI": "true" },
      "envAllowlist": ["OPENCODE_MODEL"],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    },
    {
      "id": "gemini",
      "description": "Google Gemini CLI, non-interactive (-p) with auto-approve. Invoked via node directly.",
      "command": "node",
      "args": ["{npmRoot}\\@google\\gemini-cli\\bundle\\gemini.js", "-p", "{task}"],
      "unattendedArgs": ["--approval-mode", "yolo"],
      "env": { "CI": "true" },
      "envAllowlist": ["GEMINI_MODEL"],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    },
    {
      "id": "qwen",
      "description": "Qwen Code CLI (Gemini-CLI fork), non-interactive (-p) with auto-approve. Invoked via node directly.",
      "command": "node",
      "args": ["{npmRoot}\\@qwen-code\\qwen-code\\cli-entry.js", "-p", "{task}"],
      "unattendedArgs": ["--approval-mode", "yolo"],
      "env": { "CI": "true" },
      "envAllowlist": ["OPENAI_MODEL"],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    },
    {
      "id": "deepcode",
      "description": "Deep Code CLI, non-interactive prompt mode (-p). Reads interoperable skills from ~/.agents/skills. Invoked via node directly.",
      "command": "node",
      "args": ["{npmRoot}\\@vegamo\\deepcode-cli\\dist\\cli.js", "-p", "{task}"],
      "unattendedArgs": [],
      "env": { "CI": "true" },
      "envAllowlist": [],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    },
    {
      "id": "mimo",
      "description": "Mimo (mimocode) CLI, OpenCode-family fork. One-shot 'run' mode. Invoked via node on its bin entry.",
      "command": "node",
      "args": ["{npmRoot}\\@mimo-ai\\cli\\bin\\mimo", "run", "{task}"],
      "unattendedArgs": [],
      "env": { "CI": "true" },
      "envAllowlist": ["MIMO_MODEL"],
      "closeStdin": true,
      "io": "pipe",
      "idleTimeoutSeconds": 300
    }
  ]
}
