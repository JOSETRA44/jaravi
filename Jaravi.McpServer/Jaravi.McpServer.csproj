<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Runs on newer runtimes when 8.x is absent — zero-friction installs. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- dotnet tool global: `dotnet tool install -g Jaravi.McpServer` → comando `jaravi-mcp` -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jaravi-mcp</ToolCommandName>
    <PackageId>Jaravi.McpServer</PackageId>
    <Version>0.11.0</Version>
    <Authors>Jaravi</Authors>
    <Description>Jaravi MCP server: deterministic orchestration of external CLI sub-agents (OpenCode, Claude Code, Copilot…) with context-collapse protection. MCP over stdio or HTTP + WebSocket telemetry for the Jaravi Dashboard.</Description>
    <PackageTags>mcp;agents;orchestration;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JOSETRA44/jaravi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JOSETRA44/jaravi</RepositoryUrl>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repo README is the package README: anyone landing on the NuGet page
         gets the same install/usage story instead of a bare dependency list. -->
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jaravi.Engine\Jaravi.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- McpGuard is internal on purpose (it is an implementation detail of how
         engine errors become protocol errors), but that mapping is exactly what
         the tests need to pin down. -->
    <InternalsVisibleTo Include="Jaravi.McpServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read-only default shipped inside the tool package; seeded to the
         user's %APPDATA%\jaravi\ on first run (the editable copy). -->
    <None Update="agents.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Web Control Center: embedded so the global tool stays a single exe
         with no wwwroot on disk (immutable tool-store friendly). -->
    <EmbeddedResource Include="wwwroot\index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0-preview.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
